# Mera Raasta — backend environment variables (example)
# Is file ko copy karke `.env` banao aur apni values bharo. `.env` git me commit NAHI hota.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/mera_raasta
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
CORS_ORIGIN=http://localhost:5173

# SMTP (optional — emails ke liye)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mera Raasta"

# Google Gemini AI (aistudio.google.com/apikey se free key)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_API_KEYS_EXTRA=

# NVIDIA NIM API (build.nvidia.com) — primary AI brain of AI Agent
# Free key: build.nvidia.com -> Get API Key -> nvapi-...
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# LLM7 backup provider (key optional — keyless bhi chalta hai)
LLM7_API_KEY=
LLM7_MODEL_NAME=mistral-Nemo-Instruct-2407

# data.gov.in (OGD Platform India) — optional, default sample key already in code
DATA_GOV_IN_KEY=
